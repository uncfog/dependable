# Copy to .env and adjust.  .env is gitignored.

#
# Every variable the code reads is listed in docs/TECHNICAL.md, section 9.
# Never point a local .env at the production database.

SECRET_KEY=dev-insecure-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=UTC
# LOG_LEVEL=INFO

# Have I Been Pwned password check. On by default, off under `manage.py test`.
# PWNED_PASSWORDS_ENABLED=true
# PWNED_PASSWORDS_TIMEOUT=1.5

# --- Database -----------------------------------------------------------
# Leave DB_ENGINE unset for "Postgres if reachable, else SQLite".
# DB_ENGINE=postgres   # require Postgres, never fall back
# DB_ENGINE=sqlite     # always SQLite

DATABASE_URL=postgres://postgres:postgres@localhost:5432/dependable

# ...or the discrete form instead of DATABASE_URL:
# DB_NAME=dependable
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432

# Transaction pooler (PgBouncer / Supabase port 6543) is auto-detected; force it
# with 1 or 0. Production only: seconds to keep a connection open.
# DB_POOLED=
# DB_CONN_MAX_AGE=60

# --- Public links -------------------------------------------------------
# Where this deployment answers from. Only mail needs it: an email has no
# request to resolve a relative path against, so the admissions enquiry
# reminder builds its link back to the school's public enquiry page from this.
# Left blank the link is omitted rather than sent broken.
# PUBLIC_BASE_URL=https://app.schoolcord.com

# --- Messaging ----------------------------------------------------------
# console (default) logs each message -- Sender ID included -- and marks it
# delivered, so the whole parent-messaging feature works with no credentials.
# Leave it EMPTY in production and each school sends through the gateway on its
# own messaging identity; set it to force every school onto one gateway.
# MESSAGING_PROVIDER=console

# There is no platform-wide sender ID. Each school's Sender ID lives on its
# SchoolMessagingConfig and is registered/approved under Messaging identity.

# Master gateway account. The platform pays for the units; schools send under
# their own Sender ID against it.
#
# Termii is the gateway: they support one account sending on behalf of many
# schools under each school's own Sender ID, which BulkSMS Nigeria declined to.
# TERMII_API_KEY=
# TERMII_BASE_URL=https://api.ng.termii.com

# Kept and still working, but no longer the default. Set
# MESSAGING_PROVIDER=bulksmsnigeria to move the whole platform back.
# BULKSMSNIGERIA_API_TOKEN=
# BULKSMSNIGERIA_DND=2
# BULKSMSNIGERIA_BASE_URL=https://www.bulksmsnigeria.com

# Africa's Talking is a stub: it builds the request but sends nothing.
# AFRICASTALKING_USERNAME=
# AFRICASTALKING_API_KEY=
# AFRICASTALKING_BASE_URL=https://api.africastalking.com

# --- Production (Railway) -----------------------------------------------
# Set these in the Railway dashboard, not here. Railway injects PORT and
# RAILWAY_PUBLIC_DOMAIN itself -- do not add them by hand; prod.py reads
# RAILWAY_PUBLIC_DOMAIN and appends it to ALLOWED_HOSTS/CSRF_TRUSTED_ORIGINS so
# the generated *.up.railway.app host keeps working after a rename.
#
# DJANGO_SETTINGS_MODULE=config.settings.prod   # so shell commands use prod too
# SECRET_KEY=<50+ random characters, not the dev value>
# DEBUG=False
# DB_ENGINE=postgres          # no SQLite fallback: a bad DATABASE_URL must crash
# DATABASE_URL=postgresql://postgres:...@db.<ref>.supabase.co:5432/postgres
# ALLOWED_HOSTS=theschoolcord.com,www.theschoolcord.com
# CSRF_TRUSTED_ORIGINS=https://theschoolcord.com,https://www.theschoolcord.com
# PUBLIC_BASE_URL=https://theschoolcord.com
# TIME_ZONE=Africa/Lagos
# MESSAGING_PROVIDER=console  # until the Termii Sender ID clears; then blank it
#
# RESEND_API_KEY=re_...        # production mail goes out through Resend
# DEFAULT_FROM_EMAIL=SCHOOLCORD <noreply@send.theschoolcord.com>
#
# The From: address must be on the domain verified in Resend, which is
# send.theschoolcord.com. Sending from @theschoolcord.com is rejected until
# the root domain is verified there too. There are no EMAIL_HOST/SMTP
# variables any more -- production does not use SMTP; the port is blocked.

# ---------------------------------------------------------------------------
# The account that may never be deactivated
# ---------------------------------------------------------------------------
# Deactivating an account is a platform-owner capability, so every platform owner
# holds it -- including against another platform owner. This account is out of
# reach of that, so the platform can never be locked out of itself.
#
# Environment-only: there is no default in the code. Unset, no account is
# protected and `manage.py check` warns (schoolcord.W005). Set it in Railway to
# the platform owner's login email. Not needed locally.
# PLATFORM_OWNER_EMAIL=owner@example.com

# The limits on sign-in, password reset, signup and enquiries are on by default.
# This is the emergency off switch; see docs/TECHNICAL.md section 6.
# RATE_LIMITS_ENABLED=false

# ---------------------------------------------------------------------------
# Plan payments by bank transfer (Settings > Plan). Left blank, the billing
# screen takes no orders and says so. Use the account that receives plan money,
# not a school's own account.
# ---------------------------------------------------------------------------
# BILLING_BANK_NAME=
# BILLING_ACCOUNT_NAME=
# BILLING_ACCOUNT_NUMBER=

# ---------------------------------------------------------------------------
# Uploaded files (school logos, payment receipts, applicant documents)
# ---------------------------------------------------------------------------
# Leave MEDIA_BUCKET_NAME blank and uploads are written to ./media and served by
# Django's dev server. That is right for a developer's machine and for the test
# suite, and wrong for anything deployed: the container's disk is not served and
# does not survive a restart.
#
# Set it -- and the four below it -- and every upload goes to the bucket instead.
# Supabase Storage is S3-compatible; so is Cloudflare R2, Backblaze B2 and S3
# itself, and the same five variables cover all of them.
#
# Supabase: Storage -> create a *private* bucket named "media", then
# Project Settings -> Storage -> S3 access keys to generate the pair.
#
# MEDIA_BUCKET_NAME=media
# MEDIA_S3_ENDPOINT_URL=https://<project-ref>.supabase.co/storage/v1/s3
# MEDIA_ACCESS_KEY_ID=
# MEDIA_SECRET_ACCESS_KEY=
# MEDIA_S3_REGION=us-east-1
#
# Private by default. Browsers never fetch from the bucket: the app streams every
# file through its own views (apps/core/files.py), so the bucket holds children's
# documents and bank slips without a public URL to any of them.
# MEDIA_PRIVATE_BUCKET=true
#
# Only for a deliberately public bucket (MEDIA_PRIVATE_BUCKET=false): where its
# files are served from. Leave unset otherwise.
# MEDIA_PUBLIC_BASE_URL=https://<project-ref>.supabase.co/storage/v1/object/public/media
#
# Optional, and empty by default: the bucket is for uploads, so its root is the
# media root. Set this only to share the bucket with something else -- and then
# leave the prefix out of MEDIA_PUBLIC_BASE_URL above, because django-storages
# appends it. Putting it in both gives you the prefix twice in every URL.
# MEDIA_PREFIX=
